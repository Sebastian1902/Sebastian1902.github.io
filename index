<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador Circuito ESP32-CAM</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0a0a0f;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        header h1 {
            color: #00ffcc;
            font-size: 28px;
            letter-spacing: 1.5px;
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.3);
            margin-bottom: 5px;
        }

        header p {
            color: #8892b0;
            font-size: 14px;
        }

        .app-container {
            width: 100%;
            max-width: 1100px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .circuit-wrapper {
            width: 100%;
            background: #11111a;
            border: 2px solid #232333;
            border-radius: 12px;
            padding: 20px;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            overflow: auto; /* Para pantallas pequeñas */
        }

        /* Contenedor con aspect ratio fijo para alinear SVG y Divs perfectamente */
        .circuit-board {
            position: relative;
            width: 1000px;
            height: 600px;
            margin: 0 auto;
            background-image: 
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 20px 20px;
            border-radius: 8px;
        }

        svg.wires {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .wire-base {
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        
        .wire-trace {
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
            stroke-linejoin: round;
            opacity: 0.2;
        }

        .wire-pulse {
            fill: none;
            stroke-width: 6;
            stroke-linecap: round;
            stroke-linejoin: round;
            /* La animación se controla via JS */
        }

        .component {
            position: absolute;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .label {
            position: absolute;
            top: -25px;
            background: rgba(0,0,0,0.7);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            color: #8892b0;
            white-space: nowrap;
            border: 1px solid #333;
        }

        .pin-label {
            font-size: 10px;
            color: #aaa;
            position: absolute;
        }

        /* --- SENSOR PIR --- */
        .pir-sensor {
            left: calc(15% - 70px);
            top: calc(33.3% - 90px);
            width: 140px;
            height: 180px;
        }

        .pir-board {
            width: 120px;
            height: 120px;
            background: #2e7d32; /* Verde PCB */
            border-radius: 4px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5), 0 5px 15px rgba(0,0,0,0.4);
            border: 2px solid #1b5e20;
        }

        .pir-dome {
            width: 90px;
            height: 90px;
            background: radial-gradient(circle at 30% 30%, #ffffff, #dcdcdc 60%, #999 100%);
            border-radius: 50%;
            box-shadow: 0 5px 10px rgba(0,0,0,0.4);
            position: relative;
            z-index: 3;
        }

        .pir-waves {
            position: absolute;
            width: 100px;
            height: 100px;
            border: 2px solid #00ffcc;
            border-radius: 50%;
            opacity: 0;
            z-index: 2;
            pointer-events: none;
        }

        .pir-waves.active {
            animation: radar-wave 1s infinite ease-out;
        }

        @keyframes radar-wave {
            0% { transform: scale(0.8); opacity: 0.8; }
            100% { transform: scale(2.5); opacity: 0; }
        }

        .pir-pins {
            display: flex;
            gap: 20px;
            margin-top: 5px;
        }
        
        .pin-hole {
            width: 10px;
            height: 10px;
            background: #222;
            border: 2px solid #a48332; /* Dorado */
            border-radius: 50%;
        }

        /* --- ESP32-CAM --- */
        .esp32-cam {
            left: calc(50% - 110px);
            top: calc(41.6% - 150px);
            width: 220px;
            height: 300px;
        }

        .esp-board {
            width: 180px;
            height: 260px;
            background: #151515;
            border-radius: 8px;
            position: relative;
            border: 2px solid #333;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.8), 0 10px 20px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .esp-camera-module {
            width: 90px;
            height: 90px;
            background: #0a0a0a;
            border: 2px solid #222;
            border-radius: 4px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.6);
        }

        .esp-lens {
            width: 40px;
            height: 40px;
            background: radial-gradient(circle at 40% 40%, #444, #000 70%);
            border: 2px solid #111;
            border-radius: 50%;
            box-shadow: inset 0 0 5px rgba(255,255,255,0.2);
            position: relative;
        }
        
        .esp-lens::after {
            content: '';
            position: absolute;
            top: 8px;
            left: 8px;
            width: 10px;
            height: 10px;
            background: rgba(255,255,255,0.4);
            border-radius: 50%;
        }

        .esp-processor {
            width: 100px;
            height: 100px;
            background: #222;
            border: 1px solid #444;
            margin-top: 20px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .esp-processor::after {
            content: 'ESP32';
            color: #555;
            font-size: 14px;
            font-weight: bold;
        }

        .esp-led {
            width: 8px;
            height: 8px;
            background: #333;
            border-radius: 2px;
            position: absolute;
            bottom: 20px;
            right: 20px;
        }

        .esp-led.blinking {
            animation: esp-blink 0.2s infinite alternate;
        }

        @keyframes esp-blink {
            from { background: #333; box-shadow: none; }
            to { background: #ff0000; box-shadow: 0 0 10px #ff0000; }
        }

        .esp-pin-header {
            position: absolute;
            display: flex;
            flex-direction: column;
            gap: 18px;
            padding: 10px 0;
        }

        .esp-pin-header.left { left: 5px; top: 50px; }
        .esp-pin-header.right { right: 5px; top: 50px; }

        .esp-pin {
            width: 12px;
            height: 12px;
            background: #222;
            border: 2px solid #a48332;
            border-radius: 50%;
            position: relative;
        }

        /* Nombres pines ESP32 */
        .pin-name {
            position: absolute;
            color: #aaa;
            font-size: 10px;
            top: -1px;
        }
        .esp-pin-header.left .pin-name { left: 18px; }
        .esp-pin-header.right .pin-name { right: 18px; }

        /* --- RESISTENCIA --- */
        .resistor {
            left: calc(75% - 40px);
            top: calc(41.6% - 12.5px);
            width: 80px;
            height: 25px;
            background: linear-gradient(90deg, 
                #e3c498 0%, #e3c498 15%, 
                #ff0000 15%, #ff0000 25%, /* Rojo */
                #e3c498 25%, #e3c498 40%, 
                #ff0000 40%, #ff0000 50%, /* Rojo */
                #e3c498 50%, #e3c498 65%, 
                #5d4037 65%, #5d4037 75%, /* Marrón */
                #e3c498 75%, #e3c498 85%, 
                #ffd700 85%, #ffd700 95%, /* Dorado */
                #e3c498 95%);
            border-radius: 12px;
            border: 1px solid #a67c52;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        /* --- LED ROJO --- */
        .led-red {
            left: calc(90% - 30px);
            top: calc(33.3% - 50px);
            width: 60px;
            height: 100px;
        }

        .led-bulb {
            width: 40px;
            height: 60px;
            background: rgba(180, 20, 20, 0.4);
            border: 2px solid #a00;
            border-radius: 20px 20px 5px 5px;
            position: relative;
            box-shadow: inset -5px -5px 15px rgba(0,0,0,0.5), inset 5px 5px 15px rgba(255,255,255,0.2);
            transition: all 0.3s ease;
        }
        
        .led-bulb::before {
            content: '';
            position: absolute;
            bottom: -5px;
            left: -2px;
            right: -2px;
            height: 10px;
            background: rgba(180, 20, 20, 0.6);
            border: 2px solid #a00;
            border-radius: 2px;
        }

        .led-bulb.on {
            background: #ff1a1a;
            border-color: #ff4d4d;
            box-shadow: 0 0 30px 10px rgba(255, 0, 0, 0.8), inset 0 0 10px rgba(255,255,255,0.8);
        }

        .led-legs {
            display: flex;
            gap: 10px;
            margin-top: 5px;
        }

        .led-leg {
            width: 4px;
            height: 30px;
            background: linear-gradient(90deg, #999, #eee, #999);
        }
        .led-leg.long { height: 40px; } /* Ánodo */

        .controls-panel {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #11111a;
            border: 2px solid #232333;
            border-radius: 12px;
            padding: 20px 30px;
            gap: 20px;
            flex-wrap: wrap;
        }

        .status-screen {
            background: #050505;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 15px 25px;
            min-width: 300px;
            flex-grow: 1;
            font-family: 'Courier New', Courier, monospace;
        }

        .status-title {
            color: #666;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .status-text {
            color: #888;
            font-size: 18px;
            font-weight: bold;
            transition: color 0.3s;
        }

        .btn-simular {
            background: linear-gradient(135deg, #00b4d8, #0077b6);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 119, 182, 0.4);
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-simular:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 119, 182, 0.6);
            background: linear-gradient(135deg, #00b4d8, #0096c7);
        }

        .btn-simular:active {
            transform: translateY(1px);
            box-shadow: 0 2px 10px rgba(0, 119, 182, 0.4);
        }

        .btn-simular:disabled {
            background: #333;
            color: #777;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    </style>
</head>
<body>

    <header>
        <h1>SISTEMA DE SEGURIDAD ESP32-CAM</h1>
        <p>Simulación interactiva de circuito con Sensor PIR y Alarma Visual</p>
    </header>

    <div class="app-container">
        
        <div class="circuit-wrapper">
            <div class="circuit-board" id="board">
                
                <!-- SVG PARA LOS CABLES -->
                <!-- viewBox sincronizado con las dimensiones del contenedor (1000x600) -->
                <svg class="wires" viewBox="0 0 1000 600" xmlns="http://www.w3.org/2000/svg">
                    
                    <!-- Cables Base (Gris Oscuro) -->
                    <!-- VCC (Rojo) PIR(120, 290) a ESP 5V(390, 160) -->
                    <path d="M 120 290 L 120 400 L 350 400 L 350 160 L 390 160" class="wire-base" stroke="#333"/>
                    <!-- OUT (Amarillo) PIR(150, 290) a ESP IO13(390, 220) -->
                    <path d="M 150 290 L 150 420 L 330 420 L 330 220 L 390 220" class="wire-base" stroke="#333"/>
                    <!-- GND (Negro 1) PIR(180, 290) a ESP GND(390, 190) -->
                    <path d="M 180 290 L 180 440 L 310 440 L 310 190 L 390 190" class="wire-base" stroke="#333"/>
                    
                    <!-- IO12 (Naranja) ESP IO12(390, 250) a Resistor(710, 250) -->
                    <path d="M 390 250 L 290 250 L 290 480 L 680 480 L 680 250 L 710 250" class="wire-base" stroke="#333"/>
                    <!-- Resistor a LED Anodo(885, 250) -->
                    <path d="M 790 250 L 885 250" class="wire-base" stroke="#333"/>
                    <!-- LED Catodo(915, 250) a ESP GND(610, 340) -->
                    <path d="M 915 250 L 915 340 L 610 340" class="wire-base" stroke="#333"/>


                    <!-- Cables Trazado (Color tenue) -->
                    <path d="M 120 290 L 120 400 L 350 400 L 350 160 L 390 160" class="wire-trace" stroke="#ff3333"/>
                    <path d="M 150 290 L 150 420 L 330 420 L 330 220 L 390 220" class="wire-trace" stroke="#ffeb3b"/>
                    <path d="M 180 290 L 180 440 L 310 440 L 310 190 L 390 190" class="wire-trace" stroke="#ffffff"/> <!-- Blanco para resaltar GND negro -->
                    
                    <path d="M 390 250 L 290 250 L 290 480 L 680 480 L 680 250 L 710 250" class="wire-trace" stroke="#ff9800"/>
                    <path d="M 790 250 L 885 250" class="wire-trace" stroke="#ff9800"/>
                    <path d="M 915 250 L 915 340 L 610 340" class="wire-trace" stroke="#ffffff"/>


                    <!-- Cables Animados (Pulsos) -->
                    <!-- Pulso del Sensor al ESP (Ruta Amarilla) -->
                    <path id="pulse-sensor-esp" d="M 150 290 L 150 420 L 330 420 L 330 220 L 390 220" class="wire-pulse" stroke="#ffff00" />
                    
                    <!-- Pulso del ESP al LED (Ruta Naranja ESP -> Resistor) -->
                    <path id="pulse-esp-res" d="M 390 250 L 290 250 L 290 480 L 680 480 L 680 250 L 710 250" class="wire-pulse" stroke="#ffaa00" />
                    
                    <!-- Pulso del Resistor al LED (Ruta Naranja Resistor -> LED) -->
                    <path id="pulse-res-led" d="M 790 250 L 885 250" class="wire-pulse" stroke="#ffaa00" />

                </svg>

                <!-- COMPONENTES HTML SOBRE EL SVG -->

                <div class="component pir-sensor">
                    <div class="label">PIR HC-SR501</div>
                    <div class="pir-waves" id="pir-waves"></div>
                    <div class="pir-board">
                        <div class="pir-dome"></div>
                    </div>
                    <div class="pir-pins">
                        <div class="pin-hole" style="position:relative"><span class="pin-label" style="top:15px; left:-5px">VCC</span></div>
                        <div class="pin-hole" style="position:relative"><span class="pin-label" style="top:15px; left:-5px">OUT</span></div>
                        <div class="pin-hole" style="position:relative"><span class="pin-label" style="top:15px; left:-5px">GND</span></div>
                    </div>
                </div>

                <div class="component esp32-cam">
                    <div class="label">ESP32-CAM</div>
                    <div class="esp-board">
                        
                        <div class="esp-camera-module">
                            <div class="esp-lens"></div>
                        </div>
                        
                        <div class="esp-processor"></div>
                        
                        <div class="esp-led" id="esp-led"></div>

                        <!-- Pines Izquierda -->
                        <div class="esp-pin-header left">
                            <div class="esp-pin"><span class="pin-name">5V</span></div>
                            <div class="esp-pin"><span class="pin-name">GND</span></div>
                            <div class="esp-pin"><span class="pin-name">IO13</span></div>
                            <div class="esp-pin"><span class="pin-name">IO12</span></div>
                            <div class="esp-pin"><span class="pin-name">IO2</span></div>
                        </div>

                        <!-- Pines Derecha (Solo mostramos el GND conectado para simplificar) -->
                        <div class="esp-pin-header right" style="top: 230px;">
                            <div class="esp-pin"><span class="pin-name">GND</span></div>
                        </div>

                    </div>
                </div>

                <div class="component resistor">
                    <div class="label" style="top: -20px; font-size: 10px;">220 Ω</div>
                </div>

                <div class="component led-red">
                    <div class="label" style="top: -35px">Foco LED</div>
                    <div class="led-bulb" id="red-led"></div>
                    <div class="led-legs">
                        <div class="led-leg long"></div> <!-- Ánodo (Positivo) -->
                        <div class="led-leg"></div>      <!-- Cátodo (Negativo) -->
                    </div>
                </div>

            </div>
        </div>

        <div class="controls-panel">
            <div class="status-screen">
                <div class="status-title">Log del Sistema >_</div>
                <div class="status-text" id="status-text">Estado: Reposo</div>
            </div>
            
            <button class="btn-simular" id="btn-simular">
                Simular Movimiento
            </button>
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            
            // Referencias a elementos DOM
            const btnSimular = document.getElementById("btn-simular");
            const statusText = document.getElementById("status-text");
            const pirWaves = document.getElementById("pir-waves");
            const espLed = document.getElementById("esp-led");
            const redLed = document.getElementById("red-led");

            // Referencias a los trazos SVG para el pulso
            const pulseSensorEsp = document.getElementById("pulse-sensor-esp");
            const pulseEspRes = document.getElementById("pulse-esp-res");
            const pulseResLed = document.getElementById("pulse-res-led");

            // Función para inicializar un cable para la animación de pulso
            function setupPulse(pathElement, pulseLength) {
                const length = pathElement.getTotalLength();
                // strokeDasharray = [longitud del pulso, espacio vacío restante]
                pathElement.style.strokeDasharray = `${pulseLength} ${length}`;
                // Iniciamos empujando el pulso completamente fuera de la ruta
                pathElement.style.strokeDashoffset = length;
                return length;
            }

            // Configuramos los pulsos (tamaño del pulso de luz = 40px)
            const lenSensorEsp = setupPulse(pulseSensorEsp, 40);
            const lenEspRes = setupPulse(pulseEspRes, 40);
            const lenResLed = setupPulse(pulseResLed, 40);

            // Función auxiliar para pausas (promesas)
            const delay = ms => new Promise(res => setTimeout(res, ms));

            // Función principal de la simulación
            async function iniciarSimulacion() {
                // 1. Bloquear botón
                btnSimular.disabled = true;
                
                // --- FASE 1: Detección ---
                statusText.innerText = "Estado: Movimiento detectado [PIR HIGH]";
                statusText.style.color = "#ffeb3b";
                pirWaves.classList.add("active");
                
                await delay(800); // Sensor activo un momento
                
                // --- FASE 2: Envío de señal al ESP32 ---
                pulseSensorEsp.style.transition = "stroke-dashoffset 0.8s linear";
                pulseSensorEsp.style.strokeDashoffset = "0"; // Mueve el pulso
                
                await delay(800); // Tiempo que tarda en llegar
                
                // --- FASE 3: Procesamiento en ESP32 ---
                statusText.innerText = "Estado: Procesando señal (GPIO 13) ...";
                statusText.style.color = "#00e676";
                espLed.classList.add("blinking"); // Led interno parpadea
                
                await delay(1200); // Tiempo de procesamiento
                
                // --- FASE 4: Envío de señal al LED ---
                statusText.innerText = "Estado: Activando Alarma (GPIO 12 HIGH) ...";
                pulseEspRes.style.transition = "stroke-dashoffset 0.6s linear";
                pulseEspRes.style.strokeDashoffset = "0";
                
                await delay(600); // Llega a la resistencia
                
                pulseResLed.style.transition = "stroke-dashoffset 0.2s linear";
                pulseResLed.style.strokeDashoffset = "0";
                
                await delay(200); // Llega al LED
                
                // --- FASE 5: Alarma encendida ---
                statusText.innerText = "Estado: Alarma Activada 🚨";
                statusText.style.color = "#ff1744";
                redLed.classList.add("on");
                espLed.classList.remove("blinking");
                pirWaves.classList.remove("active");

                // Mantener encendido por 4 segundos
                await delay(4000);

                // --- FASE 6: Reseteo a Reposo ---
                statusText.innerText = "Estado: Reposo";
                statusText.style.color = "#888";
                redLed.classList.remove("on");
                
                // Resetear las líneas de pulso (sin transición para que no se vea retroceder)
                pulseSensorEsp.style.transition = "none";
                pulseSensorEsp.style.strokeDashoffset = lenSensorEsp;
                
                pulseEspRes.style.transition = "none";
                pulseEspRes.style.strokeDashoffset = lenEspRes;
                
                pulseResLed.style.transition = "none";
                pulseResLed.style.strokeDashoffset = lenResLed;

                // Desbloquear botón
                btnSimular.disabled = false;
            }

            // Event listener
            btnSimular.addEventListener("click", iniciarSimulacion);
        });
    </script>
</body>
</html>
